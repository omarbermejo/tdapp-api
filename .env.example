# Copia a .env y genera el secreto con:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRES_IN=30d
PORT=3000
DB_PATH=data.db
CORS_ORIGIN=*
# Client IDs de Google separados por coma (iOS, Android, web). Vacio = /auth/google responde 401.
GOOGLE_CLIENT_IDS=
