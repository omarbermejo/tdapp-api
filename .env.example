# Copia a .env y genera el secreto con:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRES_IN=30d
PORT=3000
DB_PATH=data.db
CORS_ORIGIN=*
# Client IDs de Google separados por coma (iOS, Android, web). Vacio = /auth/google responde 401.
GOOGLE_CLIENT_IDS=
# Bundle id de la app (y Services ID si algun dia hay web). Vacio = /auth/apple responde 401.
APPLE_CLIENT_IDS=

# Resend: vacio = el codigo de verificacion sale en la consola en vez del correo
RESEND_API_KEY=
MAIL_FROM=tdapp <onboarding@resend.dev>
